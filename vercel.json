{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://bpoxaxwczezfhncntomq.supabase.co wss://bpoxaxwczezfhncntomq.supabase.co; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "X-DNS-Prefetch-Control", "value": "off" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/instalar", "destination": "/" },
    { "source": "/inicio", "destination": "/" },
    { "source": "/alunos", "destination": "/" },
    { "source": "/chamada", "destination": "/" },
    { "source": "/turmas", "destination": "/" },
    { "source": "/turmas/:id", "destination": "/" },
    { "source": "/professores", "destination": "/" },
    { "source": "/locais", "destination": "/" },
    { "source": "/publicacoes", "destination": "/" },
    { "source": "/comunicados", "destination": "/" },
    { "source": "/checkin", "destination": "/" },
    { "source": "/frequencia", "destination": "/" },
    { "source": "/mais", "destination": "/" },
    { "source": "/perfil", "destination": "/" }
  ]
}
